/* ============================================================================
 *  HDDHealth Monitor 1.3 - Win32 resource script
 *
 *  Author  : Ari Sohandri Putra
 *  Sponsor : https://github.com/sponsors/arisohandriputra/
 *  License : MIT
 *
 *  Defines: app icons, embedded manifest (Common-Controls v6 + admin),
 *  and the VS_VERSION_INFO block that Explorer shows in Properties.
 * ============================================================================
 */


#include <windows.h>
#include "resource.h"

/* Application icons.  The same .ico file is reused for both the main
   application icon and the drive icon used in the tray / drive buttons. */
IDI_APPICON  ICON  "app.ico"
IDI_HDD      ICON  "app.ico"

/* Embed the application manifest (Common-Controls v6 + requireAdministrator). */
1 24 "app.manifest"

/* Embed the drive database (drives.json) as an RT_RCDATA resource.
   This way it ships inside the .exe — no separate file to distribute. */
IDR_DRIVES_JSON  RCDATA  "drives.json"

/* ----------------------------------------------------------------------------
 *  Version information block.
 *
 *  Windows Explorer's "Details" tab reads these values from the .exe.
 *  All fields are kept in sync with the author / sponsor metadata used
 *  elsewhere in the project.
 * ---------------------------------------------------------------------------- */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Ari Sohandri Putra"
            VALUE "FileDescription",  "Low-Level HDD Health Monitor - Free Open Source (VS2010 build)"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "HDD Health Monitor 1.3"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ari Sohandri Putra. MIT License."
            VALUE "OriginalFilename", "HDDHealth.exe"
            VALUE "ProductName",      "HDDHealth 1.3"
            VALUE "ProductVersion",   "1.3.0.0"
            VALUE "Comments",         "100% Free Open Source Software. Author: Ari Sohandri Putra. Sponsor: https://github.com/sponsors/arisohandriputra/"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
